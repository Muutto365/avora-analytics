<.focus_box>
  <:title>
    Welcome to Avora Analytics!
  </:title>

  <:footer>
    <.focus_list>
      <:item>
        <.styled_link href={Routes.auth_path(@conn, :login)}>
          Login
        </.styled_link>
      </:item>
      <:item>
        <.styled_link href={Routes.auth_path(@conn, :register_form)}>
          Register
        </.styled_link>
      </:item>
    </.focus_list>
  </:footer>
</.focus_box>
