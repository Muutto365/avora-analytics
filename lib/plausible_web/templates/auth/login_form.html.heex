<.focus_box>
  <:title>
    {Phoenix.Flash.get(@flash, :login_title) ||
      if(Plausible.Auth.OIDC.password_login_disabled?(),
        do: gettext("Sign in"),
        else: gettext("Enter your account credentials")
      )}
  </:title>
  <:subtitle>
    <%= if Phoenix.Flash.get(@flash, :login_instructions) do %>
      <p class="text-gray-500 mt-1 mb-2">
        {Phoenix.Flash.get(@flash, :login_instructions)}
      </p>
    <% end %>
  </:subtitle>
  <%!-- Fork addition: OIDC single sign-on --%>
  <div :if={Plausible.Auth.OIDC.enabled?()} class="my-4 mt-8">
    <.button_link
      class="w-full"
      mt?={false}
      theme={if Plausible.Auth.OIDC.password_login_disabled?(), do: "primary", else: "secondary"}
      href={PlausibleWeb.OIDCController.login_path(@conn)}
    >
      {Plausible.Auth.OIDC.button_label()}
    </.button_link>
    <%= if Plausible.Auth.OIDC.password_login_disabled?() do %>
      <%= if login_error = Phoenix.Flash.get(@flash, :login_error) do %>
        <div class="text-red-500 mt-4">{login_error}</div>
      <% end %>
    <% end %>
  </div>
  <.form
    :let={f}
    :if={not Plausible.Auth.OIDC.password_login_disabled?()}
    for={@conn}
    action="/login"
  >
    <div class="my-4 mt-8">
      <.input
        type="email"
        autocomplete="username"
        placeholder="user@example.com"
        field={f[:email]}
        label={gettext("Email")}
      />
    </div>
    <div class="my-4">
      <.input
        type="password"
        autocomplete="current-password"
        id="current-password"
        field={f[:password]}
        label={gettext("Password")}
      />
    </div>

    <%= if login_error = Phoenix.Flash.get(@flash, :login_error) do %>
      <div class="text-red-500 mt-4">{login_error}</div>
    <% end %>

    <.input type="hidden" field={f[:return_to]} />

    <.button class="w-full" type="submit">{gettext("Log in")}</.button>
  </.form>

  <:footer>
    <.focus_list>
      <:item :if={
        Keyword.fetch!(Application.get_env(:plausible, :selfhost), :disable_registration) == false
      }>
        {gettext("Don't have an account?")}
        <.styled_link href="/register">
          {gettext("Register")}
        </.styled_link>
      </:item>
      <:item :if={ee?()}>
        <%= on_ee do %>
          Have a Single Sign-on account?
          <.styled_link href={
            Routes.sso_path(@conn, :login_form,
              return_to: @conn.params["return_to"],
              prefer: "manual"
            )
          }>
            Sign in here
          </.styled_link>
          instead.
        <% end %>
      </:item>
      <:item :if={not Plausible.Auth.OIDC.password_login_disabled?()}>
        {gettext("Forgot password?")}
        <.styled_link href="/password/request-reset">
          {gettext("Reset it")}
        </.styled_link>
      </:item>
    </.focus_list>
  </:footer>
</.focus_box>
